<odoo>
  <record id="view_facturas_pagadas_excel_wizard" model="ir.ui.view">
    <field name="name">facturas.pagadas.excel.wizard.form</field>
    <field name="model">facturas.pagadas.excel.wizard</field>
    <field name="arch" type="xml">
      <form string="Exportar Facturas Pagadas">
        <group>
          <field name="date_start"/>
          <field name="date_end"/>
        </group>
        <footer>
          <button name="exportar_excel" string="Exportar Excel" type="object" class="btn-primary"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_facturas_pagadas_excel_wizard" model="ir.actions.act_window">
    <field name="name">Exportar Facturas Pagadas</field>
    <field name="res_model">facturas.pagadas.excel.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_excel_report_root"
            name="Reportes de facturación Excel"
            parent="account.menu_finance_reports"
            sequence="10"/>

  <menuitem id="menu_facturas_pagadas_excel"
            name="Facturas Pagadas Excel"
            parent="menu_excel_report_root"
            action="action_facturas_pagadas_excel_wizard"
            sequence="1"/>
</odoo>
