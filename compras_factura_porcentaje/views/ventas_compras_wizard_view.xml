<odoo>
  <record id="view_ventas_compras_wizard" model="ir.ui.view">
    <field name="name">ventas.compras.wizard.form</field>
    <field name="model">ventas.compras.wizard</field>
    <field name="arch" type="xml">
      <form string="Generar Reporte Ventas-Compras">
        <group>
          <field name="date_start"/>
          <field name="date_end"/>
        </group>
        <footer>
          <button name="generar_excel_manual" type="object" string="Exportar a Excel" class="btn-primary"/>
          <button string="Cancelar" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_ventas_compras_wizard" model="ir.actions.act_window">
    <field name="name">Reporte Ventas-Compras</field>
    <field name="res_model">ventas.compras.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
