<odoo>
    <data>
        <!-- Heredamos la vista base del reporte de antigüedad de saldos -->
        <record id="view_account_aged_receivable_report_inherit" model="ir.ui.view">
            <field name="name">account.aged.receivable.report.inherit.tax</field>
            <field name="model">account.report</field>
            <field name="inherit_id" ref="account_reports.account_aged_receivable_report_view"/>
            <field name="arch" type="xml">

                <!-- Agregar encabezado -->
                <xpath expr="//table/thead/tr" position="inside">
                    <th>Impuesto total</th>
                </xpath>

                <!-- Agregar celda de valores -->
                <xpath expr="//table/tbody/tr/td[last()]" position="after">
                    <td t-esc="line['columns'][-1]['name'] if line.get('columns') else ''"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
