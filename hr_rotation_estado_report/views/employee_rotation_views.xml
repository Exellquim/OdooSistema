<?xml version="1.0" encoding="UTF-8"?>
<field name="name">employee.rotation.report.wizard.form</field>
<field name="model">employee.rotation.report.wizard</field>
<field name="arch" type="xml">
<form string="Reporte de Rotación por Estado" create="false" edit="false">
<group>
<field name="target_month"/>
</group>
<footer>
<button name="action_compute" type="object" string="Calcular" class="btn-primary"/>
<button string="Cerrar" class="btn-secondary" special="cancel"/>
</footer>
</form>
</field>
</record>


<!-- Result Lines: Tree -->
<record id="view_employee_rotation_line_tree" model="ir.ui.view">
<field name="name">employee.rotation.report.line.tree</field>
<field name="model">employee.rotation.report.line</field>
<field name="arch" type="xml">
<tree string="Resultados de Rotación por Estado" editable="bottom">
<field name="estado"/>
<field name="inicio"/>
<field name="fin"/>
<field name="rotacion"/>
<field name="ingreso"/>
<field name="porcentaje" widget="percentage"/>
</tree>
</field>
</record>


<!-- Result Lines: Graph (porcentaje por estado) -->
<record id="view_employee_rotation_line_graph" model="ir.ui.view">
<field name="name">employee.rotation.report.line.graph</field>
<field name="model">employee.rotation.report.line</field>
<field name="arch" type="xml">
<graph string="% Rotación por Estado" type="bar">
<field name="estado" type="row"/>
<field name="porcentaje" type="measure"/>
</graph>
</field>
</record>


<!-- Action to display results (tree first, then graph) -->
<record id="action_employee_rotation_lines" model="ir.actions.act_window">
<field name="name">Rotación por Estado</field>
<field name="res_model">employee.rotation.report.line</field>
<field name="view_mode">tree,graph</field>
<field name="view_id" ref="view_employee_rotation_line_tree"/>
<field name="context">{"search_default_group_by_estado": 0}</field>
<field name="help" type="html">
<p>
Tabla y gráfica de rotación por estado del empleado para el mes seleccionado en el asistente.
</p>
</field>
</record>


<!-- Menu + action del wizard -->
<record id="action_employee_rotation_wizard" model="ir.actions.act_window">
<field name="name">Reporte de Rotación por Estado</field>
<field name="res_model">employee.rotation.report.wizard</field>
<field name="view_mode">form</field>
<field name="view_id" ref="view_employee_rotation_report_wizard_form"/>
<field name="target">new</field>
</record>


<menuitem id="menu_hr_rotation_root" name="Reportes RH" parent="hr.menu_hr_root" sequence="95"/>
<menuitem id="menu_hr_rotation_wizard" name="Rotación por Estado" parent="menu_hr_rotation_root" action="action_employee_rotation_wizard" sequence="10"/>


</odoo>