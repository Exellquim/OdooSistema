<record id="view_employee_rotation_line_tree" model="ir.ui.view">
    <field name="name">employee.rotation.report.line.tree</field>
    <field name="model">employee.rotation.report.line</field>
    <field name="arch" type="xml">
        <tree string="Resultados de Rotación por Estado">
            <field name="estado"/>
            <field name="mes_nombre" string="Mes"/>    
            <field name="inicio"/>
            <field name="fin"/>
            <field name="rotacion"/>
            <field name="ingreso"/>
            <field name="porcentaje_txt"/>
        </tree>
    </field>
</record>

<!-- Acción secundaria en el listado -->
<record id="action_employee_rotation_lines" model="ir.actions.act_window">
    <field name="name">Rotación por Estado</field>
    <field name="res_model">employee.rotation.report.line</field>
    <field name="view_mode">tree,graph</field>
    <field name="help" type="html">
        <p>Tabla y gráfica de rotación por estado del empleado para el mes elegido.</p>
    </field>
    <field name="context">{}</field>
</record>

<!-- Botón en "Acciones" del listado -->
<record id="action_view_archived_employees_from_lines" model="ir.actions.server">
    <field name="name">Ver Archivados</field>
    <field name="model_id" ref="model_employee_rotation_report_line"/>
    <field name="binding_model_id" ref="model_employee_rotation_report_line"/>
    <field name="binding_view_types">tree</field>
    <field name="state">code</field>
    <field name="code">
action = records.mapped('wizard_id').action_view_archived_employees()
    </field>
</record>
