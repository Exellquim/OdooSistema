<odoo>
  <record id="view_facturas_proveedores_pagadas_excel_wizard" model="ir.ui.view">
    <field name="name">facturas.proveedores.pagadas.excel.wizard.form</field>
    <field name="model">facturas.proveedores.pagadas.excel.wizard</field>
    <field name="arch" type="xml">
      <form string="Exportar Facturas de Proveedores Pagadas">
        <group>
          <field name="company_id"/>
          <field name="date_start"/>
          <field name="date_end"/>
        </group>
        <footer>
          <button name="exportar_excel" string="Exportar Excel" type="object" class="btn-primary"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_facturas_proveedores_pagadas_excel_wizard" model="ir.actions.act_window">
    <field name="name">Facturas de Proveedores Pagadas</field>
    <field name="res_model">facturas.proveedores.pagadas.excel.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_facturas_proveedores_pagadas_excel"
            name="Facturas de Proveedores Pagadas Excel"
            parent="account.menu_finance_reports"
            action="action_facturas_proveedores_pagadas_excel_wizard"
            sequence="50"/>
</odoo>
