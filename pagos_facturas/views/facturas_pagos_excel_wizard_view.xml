<odoo>
    <record id="view_facturas_pagos_excel_wizard" model="ir.ui.view">
        <field name="name">facturas.pagos.excel.wizard.form</field>
        <field name="model">facturas.pagos.excel.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar Facturas con Pagos">
                <group>
                    <field name="date_start"/>
                    <field name="date_end"/>
                </group>

                <footer>
                    <button name="exportar_excel"
                            string="Exportar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
